# LEAKGUARD Environment Configuration
# Copy this file to .env and modify values as needed.
# All settings provide safe, privacy-preserving defaults if omitted.

# Maximum input character length allowed per scan (mitigates ReDoS & memory exhaustion)
LEAKGUARD_MAX_INPUT_LENGTH=20000

# Maximum characters revealed in findings/exports (0 = complete masking, up to 2 for cards)
LEAKGUARD_MAX_REVEAL_CHARS=0

# Shannon entropy threshold for secret detection
LEAKGUARD_ENTROPY_THRESHOLD=4.5

# Default redaction mode: placeholder | mask | remove
LEAKGUARD_DEFAULT_REDACTION_MODE=placeholder

# Application logging level: DEBUG | INFO | WARNING | ERROR
LEAKGUARD_LOG_LEVEL=INFO

# In-memory session expiry time in seconds
LEAKGUARD_SESSION_EXPIRY_SECONDS=3600
